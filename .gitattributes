# Keep dataset, label sheets and JMeter results byte-for-byte identical on every OS.
# Line-ending conversion changes multi-line narratives, which changes their
# SHA-256 ranking in scripts/create_golden_set.py and so the selected sample.
*.csv -text
*.jtl -text
# JMeter input data and raw evidence: hashes are recorded in run metadata.
*.tsv -text
*.jsonl -text
*.log -text
# Search terms are hashed inputs too; preserve their LF bytes on Windows.
jmeter/data/search_terms.txt -text

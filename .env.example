# Base URL of the local Ollama server. Use http://localhost:11434 when the API runs
# on the host; http://host.docker.internal:11434 when it runs in Docker.
# (Not OLLAMA_HOST: that is the Ollama server's own bind-address variable.)
OLLAMA_URL=http://host.docker.internal:11434
# Exact Ollama tag of the model to use. Change this line to switch candidate model,
# then restart the API. Candidates (see docs/models.md):
#   gemma2:2b   llama3.2:3b   qwen2.5:7b   llama3.1:8b
OLLAMA_MODEL=
# Seconds to wait for one blocking classification request before returning 502.
OLLAMA_TIMEOUT_SECONDS=120
DATABASE_URL=sqlite:///./data/tickets.db
LOG_LEVEL=INFO
